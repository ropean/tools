---
import ToolLayout from '../layouts/ToolLayout.astro';
import { TOOLS } from '../data/tools.js';

const tool = TOOLS.find((t) => t.id === 'qr-generator');
---
<ToolLayout tool={tool}>
  <div class="qr">
    <div class="qr-tabs" role="tablist">
      <button type="button" class="qr-tab active" id="qr-tab-generate" role="tab" aria-selected="true">Generate</button>
      <button type="button" class="qr-tab" id="qr-tab-decode" role="tab" aria-selected="false">Decode</button>
    </div>

    <div class="qr-panel" id="qr-panel-generate">
      <div class="qr-field">
        <label class="qr-label" for="qr-text">Text or URL</label>
        <textarea class="field mono" id="qr-text" rows="10" spellcheck="false" placeholder="https://tools.ropean.org">https://tools.ropean.org</textarea>
      </div>

      <div class="qr-row">
        <div class="qr-field">
          <label class="qr-label" for="qr-style">Style</label>
          <select class="field" id="qr-style">
            <option value="square" selected>Square</option>
            <option value="dino">Dino dots</option>
          </select>
        </div>
        <div class="qr-field">
          <label class="qr-label" for="qr-ecl">Error correction</label>
          <select class="field" id="qr-ecl">
            <option value="L">L — 7%</option>
            <option value="M" selected>M — 15%</option>
            <option value="Q">Q — 25%</option>
            <option value="H">H — 30%</option>
          </select>
        </div>
        <div class="qr-field">
          <label class="qr-label" for="qr-size">Size (px)</label>
          <input class="field" type="number" id="qr-size" value="320" min="80" max="2000" step="8" />
        </div>
        <div class="qr-field">
          <label class="qr-label" for="qr-margin">Quiet zone</label>
          <input class="field" type="number" id="qr-margin" value="4" min="0" max="16" />
        </div>
      </div>

      <div class="qr-row">
        <div class="qr-field qr-color">
          <label class="qr-label" for="qr-dark">Foreground</label>
          <input type="color" id="qr-dark" value="#1c1c1c" />
        </div>
        <div class="qr-field qr-color">
          <label class="qr-label" for="qr-light">Background</label>
          <input type="color" id="qr-light" value="#ffffff" />
        </div>
      </div>

      <p class="qr-msg" id="qr-msg" hidden></p>

      <div class="qr-preview">
        <div class="qr-canvas-wrap">
          <canvas id="qr-canvas" width="320" height="320" aria-label="QR code preview"></canvas>
        </div>
        <div class="qr-actions">
          <button type="button" class="btn btn-primary" id="qr-png">Download PNG</button>
          <button type="button" class="btn" id="qr-svg">Download SVG</button>
        </div>
      </div>
    </div>

    <div class="qr-panel" id="qr-panel-decode" hidden>
      <div class="qr-field">
        <label class="qr-label" for="qr-drop">Source image</label>
        <div class="qr-drop" id="qr-drop" tabindex="0" role="button" aria-label="Upload, drag & drop, or paste an image to decode">
          <p class="qr-drop-text">Click to upload, drag &amp; drop an image, or paste (Ctrl/Cmd+V)</p>
          <input type="file" id="qr-file" accept="image/*" hidden />
        </div>
      </div>

      <div class="qr-decode-preview" id="qr-decode-preview" hidden>
        <img id="qr-decode-img" alt="Uploaded image" />
      </div>

      <p class="qr-msg" id="qr-decode-msg" hidden></p>

      <div class="qr-field">
        <label class="qr-label" for="qr-decode-out">Decoded text</label>
        <textarea class="field mono" id="qr-decode-out" rows="10" spellcheck="false" readonly placeholder="Decoded text will appear here"></textarea>
      </div>
      <div class="qr-actions">
        <button type="button" class="btn btn-copy" id="qr-decode-copy">Copy</button>
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .qr { display: flex; flex-direction: column; gap: 20px; }

  .qr-tabs { display: inline-flex; align-self: flex-start; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .qr-tab { background: transparent; border: none; padding: 7px 16px; font-size: 13px; color: var(--muted); cursor: pointer; }
  .qr-tab.active { background: var(--dark); color: var(--on-dark); }

  .qr-panel { display: flex; flex-direction: column; gap: 16px; }

  .qr-field { display: flex; flex-direction: column; gap: 6px; }
  .qr-label { font-size: 12px; color: var(--muted); }
  .qr-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .qr-row .qr-field { flex: 1 1 120px; }
  .qr-color input[type='color'] {
    width: 100%; height: 40px; padding: 4px;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--bg); cursor: pointer;
  }
  .qr-msg { margin: 0; font-size: 13px; color: var(--error); }

  .qr-preview { display: flex; flex-direction: column; gap: 16px; align-items: center; }
  .qr-canvas-wrap {
    width: 100%;
    max-width: 420px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--subtle-2);
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #qr-canvas { max-width: 100%; height: auto; image-rendering: pixelated; border-radius: 4px; }
  .qr-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }

  .qr-drop {
    display: flex; align-items: center; justify-content: center; text-align: center;
    min-height: 140px; padding: 24px;
    border: 1px dashed var(--border-strong); border-radius: var(--radius-lg);
    background: var(--subtle-2); cursor: pointer;
  }
  .qr-drop.qr-drop-active { border-color: var(--fg); background: var(--subtle); }
  .qr-drop-text { margin: 0; font-size: 13px; color: var(--muted); }

  .qr-decode-preview {
    display: flex; justify-content: center;
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    background: var(--subtle-2); padding: 16px;
  }
  .qr-decode-preview img { max-width: 100%; max-height: 320px; border-radius: 4px; }
</style>

<script>
  import qrcode from 'qrcode-generator';
  import jsQR from 'jsqr';

  // qrcode-generator's default encoder truncates every char to 8 bits, which
  // corrupts CJK/emoji; encode as UTF-8 so decoders read the text back intact.
  qrcode.stringToBytes = (s) => Array.from(new TextEncoder().encode(s));

  const $ = (id) => document.getElementById(id);

  // ---- Tabs ----
  const tabGenerate = $('qr-tab-generate');
  const tabDecode = $('qr-tab-decode');
  const panelGenerate = $('qr-panel-generate');
  const panelDecode = $('qr-panel-decode');

  function showTab(which) {
    const generate = which === 'generate';
    panelGenerate.hidden = !generate;
    panelDecode.hidden = generate;
    tabGenerate.classList.toggle('active', generate);
    tabDecode.classList.toggle('active', !generate);
    tabGenerate.setAttribute('aria-selected', String(generate));
    tabDecode.setAttribute('aria-selected', String(!generate));
  }
  tabGenerate.addEventListener('click', () => showTab('generate'));
  tabDecode.addEventListener('click', () => showTab('decode'));

  // ---- Generate ----
  const textEl = $('qr-text');
  const styleEl = $('qr-style');
  const eclEl = $('qr-ecl');
  const sizeEl = $('qr-size');
  const marginEl = $('qr-margin');
  const darkEl = $('qr-dark');
  const lightEl = $('qr-light');
  const canvas = $('qr-canvas');
  const ctx = canvas.getContext('2d');
  const msgEl = $('qr-msg');

  let model = null; // last successful QR model, for exports

  function setMsg(text) {
    if (!text) { msgEl.hidden = true; msgEl.textContent = ''; return; }
    msgEl.hidden = false;
    msgEl.textContent = text;
  }

  // Chrome-style T-rex sprite, facing right ('#' = filled), padded to a square.
  const DINO_SIZE = 18;
  const DINO = [
    '..........########',
    '........##.#######',
    '........##########',
    '........##########',
    '........##########',
    '........#####.....',
    '#.......#####.....',
    '#......#######....',
    '##....#########.#.',
    '###..###########..',
    '###############...',
    '.##############...',
    '..############....',
    '...##########.....',
    '....####..####....',
    '....###....###....',
    '....##.....##.....',
    '....####...####...',
  ];
  const MIN_DINO_VERSION = 5; // 37 modules: keeps the logo cut-out a small share of the code

  const isDino = () => styleEl.value === 'dino';

  function encode(text, version, ecl) {
    const qr = qrcode(version, ecl);
    qr.addData(text);
    qr.make();
    return qr;
  }

  function build() {
    const text = textEl.value;
    if (!text) { model = null; ctx.clearRect(0, 0, canvas.width, canvas.height); setMsg(''); return; }
    try {
      // The logo cut-out destroys modules, so dino style needs at least Q.
      const ecl = isDino() && 'LM'.includes(eclEl.value) ? 'Q' : eclEl.value;
      let qr = encode(text, 0, ecl); // 0 = auto-pick smallest version
      if (isDino() && qr.getModuleCount() < 17 + 4 * MIN_DINO_VERSION) qr = encode(text, MIN_DINO_VERSION, ecl);
      model = qr;
      setMsg('');
      draw();
    } catch (err) {
      model = null;
      setMsg('Cannot encode: ' + (err && err.message ? err.message : 'text too long for this level.'));
    }
  }

  function geometry() {
    const count = model.getModuleCount();
    const margin = Math.max(0, parseInt(marginEl.value, 10) || 0);
    const total = count + margin * 2;
    const target = Math.max(80, parseInt(sizeEl.value, 10) || 320);
    const scale = Math.max(1, Math.floor(target / total)); // integer px per module = crisp
    return { count, margin, total, scale, dim: scale * total };
  }

  const num = (n) => +n.toFixed(3);

  function roundedRect(x, y, w, h, r) {
    const iw = num(w - 2 * r), ih = num(h - 2 * r);
    const arc = (dx, dy) => `a${r} ${r} 0 0 1 ${num(dx)} ${num(dy)}`;
    return `M${num(x + r)} ${num(y)}h${iw}${arc(r, r)}v${ih}${arc(-r, r)}h${-iw}${arc(-r, -r)}v${-ih}${arc(r, -r)}z`;
  }

  function circle(cx, cy, r) {
    return `M${num(cx - r)} ${num(cy)}a${r} ${r} 0 1 0 ${num(2 * r)} 0a${r} ${r} 0 1 0 ${num(-2 * r)} 0z`;
  }

  // Dark modules as one SVG path in module units (quiet zone included). Shapes
  // never overlap, so it is filled with the even-odd rule: that is how the
  // finder rings get their hollow middle.
  function pathData() {
    const { count, margin: o } = geometry();
    let d = '';

    if (!isDino()) {
      for (let r = 0; r < count; r++) {
        for (let c = 0; c < count; c++) {
          if (model.isDark(r, c)) d += `M${c + o} ${r + o}h1v1h-1z`;
        }
      }
      return d;
    }

    // Rounded finder patterns: ring, hole, and centre as nested rounded squares.
    for (const [fx, fy] of [[0, 0], [count - 7, 0], [0, count - 7]]) {
      d += roundedRect(o + fx, o + fy, 7, 7, 2.2)
        + roundedRect(o + fx + 1, o + fy + 1, 5, 5, 1.3)
        + roundedRect(o + fx + 2, o + fy + 2, 3, 3, 1);
    }

    // Logo area: a centred, module-aligned square left empty for the dino.
    const logo = Math.round(count * 0.2);
    let hole = logo + 1;
    if ((count - hole) % 2) hole++;
    const holeStart = (count - hole) / 2;

    const inFinder = (r, c) => (r < 7 && (c < 7 || c >= count - 7)) || (r >= count - 7 && c < 7);
    const inHole = (r, c) => r >= holeStart && r < holeStart + hole && c >= holeStart && c < holeStart + hole;
    for (let r = 0; r < count; r++) {
      for (let c = 0; c < count; c++) {
        if (model.isDark(r, c) && !inFinder(r, c) && !inHole(r, c)) d += circle(o + c + 0.5, o + r + 0.5, 0.42);
      }
    }

    // Dino: one rect per horizontal run of filled sprite pixels.
    const px = logo / DINO_SIZE;
    const origin = o + (count - logo) / 2;
    DINO.forEach((row, y) => {
      for (const run of row.matchAll(/#+/g)) {
        d += `M${num(origin + run.index * px)} ${num(origin + y * px)}h${num(run[0].length * px)}v${num(px)}h${num(-run[0].length * px)}z`;
      }
    });
    return d;
  }

  function draw() {
    if (!model) return;
    const { scale, dim } = geometry();
    canvas.width = dim;
    canvas.height = dim;
    ctx.fillStyle = lightEl.value;
    ctx.fillRect(0, 0, dim, dim);
    ctx.fillStyle = darkEl.value;
    ctx.save();
    ctx.scale(scale, scale);
    ctx.fill(new Path2D(pathData()), 'evenodd');
    ctx.restore();
  }

  function svgString() {
    const { total } = geometry();
    // crispEdges would jag the round shapes, so only square style gets it.
    const rendering = isDino() ? '' : ' shape-rendering="crispEdges"';
    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${total} ${total}"${rendering}>`
      + `<rect width="${total}" height="${total}" fill="${lightEl.value}"/>`
      + `<path d="${pathData()}" fill="${darkEl.value}" fill-rule="evenodd"/></svg>`;
  }

  function download(href, name) {
    const a = document.createElement('a');
    a.href = href;
    a.download = name;
    document.body.appendChild(a);
    a.click();
    a.remove();
  }

  $('qr-png').addEventListener('click', () => {
    if (!model) return;
    download(canvas.toDataURL('image/png'), 'qrcode.png');
  });
  $('qr-svg').addEventListener('click', () => {
    if (!model) return;
    const blob = new Blob([svgString()], { type: 'image/svg+xml' });
    const url = URL.createObjectURL(blob);
    download(url, 'qrcode.svg');
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });

  // Text/level/style changes rebuild the model (debounced); size/margin/color only redraw.
  let t;
  textEl.addEventListener('input', () => { clearTimeout(t); t = setTimeout(build, 150); });
  eclEl.addEventListener('change', build);
  styleEl.addEventListener('change', build);
  for (const el of [sizeEl, marginEl, darkEl, lightEl]) {
    el.addEventListener('input', () => { if (model) draw(); });
  }

  build();

  // ---- Decode ----
  const dropEl = $('qr-drop');
  const fileEl = $('qr-file');
  const decodePreview = $('qr-decode-preview');
  const decodeImg = $('qr-decode-img');
  const decodeMsg = $('qr-decode-msg');
  const decodeOut = $('qr-decode-out');
  const decodeCopy = $('qr-decode-copy');
  const decodeCanvas = document.createElement('canvas');
  const decodeCtx = decodeCanvas.getContext('2d', { willReadFrequently: true });

  function setDecodeMsg(text) {
    if (!text) { decodeMsg.hidden = true; decodeMsg.textContent = ''; return; }
    decodeMsg.hidden = false;
    decodeMsg.textContent = text;
  }

  // jsQR binarizes on standard luma, which can flatten low-contrast colors
  // (e.g. pure yellow vs. white differ by only ~29/255 in luma). As a
  // fallback, try each single RGB channel with contrast stretched to full
  // range — one channel usually separates foreground from background even
  // when luma can't.
  function extractChannel(data, width, height, channel) {
    const n = width * height;
    const out = new Uint8ClampedArray(n);
    for (let i = 0; i < n; i++) {
      const o = i * 4;
      out[i] = channel(data[o], data[o + 1], data[o + 2]);
    }
    return out;
  }

  function stretchContrast(values) {
    let min = 255, max = 0;
    for (const v of values) {
      if (v < min) min = v;
      if (v > max) max = v;
    }
    const range = max - min;
    if (range < 8) return null; // effectively flat, not worth trying
    const scale = 255 / range;
    const out = new Uint8ClampedArray(values.length);
    for (let i = 0; i < values.length; i++) out[i] = (values[i] - min) * scale;
    return out;
  }

  function grayscaleImageData(width, height, values) {
    const out = new Uint8ClampedArray(width * height * 4);
    for (let i = 0; i < values.length; i++) {
      const v = values[i];
      const o = i * 4;
      out[o] = v; out[o + 1] = v; out[o + 2] = v; out[o + 3] = 255;
    }
    return new ImageData(out, width, height);
  }

  // Stylized codes (round dots with gaps between modules, like Chrome's QR)
  // defeat jsQR's finder/module sampling. A box blur fuses neighbouring dots
  // back into solid-ish modules; jsQR's own thresholding then handles the rest.
  function boxBlur(values, width, height, radius) {
    const tmp = new Float32Array(values.length);
    const out = new Uint8ClampedArray(values.length);
    const win = radius * 2 + 1;
    for (let y = 0; y < height; y++) {
      const row = y * width;
      let sum = 0;
      for (let x = -radius; x <= radius; x++) sum += values[row + Math.min(width - 1, Math.max(0, x))];
      for (let x = 0; x < width; x++) {
        tmp[row + x] = sum / win;
        sum += values[row + Math.min(width - 1, x + radius + 1)] - values[row + Math.max(0, x - radius)];
      }
    }
    for (let x = 0; x < width; x++) {
      let sum = 0;
      for (let y = -radius; y <= radius; y++) sum += tmp[Math.min(height - 1, Math.max(0, y)) * width + x];
      for (let y = 0; y < height; y++) {
        out[y * width + x] = sum / win;
        sum += tmp[Math.min(height - 1, y + radius + 1) * width + x] - tmp[Math.max(0, y - radius) * width + x];
      }
    }
    return out;
  }

  const BLUR_RADII = [1, 2, 3, 4, 6];

  const DECODE_CHANNELS = [
    (r, g, b) => 0.299 * r + 0.587 * g + 0.114 * b, // luma
    (r) => r,
    (_r, g) => g,
    (_r, _g, b) => b,
  ];

  const MAX_DECODE_DIM = 1200; // cap work on big photos so the UI stays responsive
  const MIN_DECODE_DIM = 100;  // below this a downscaled retry cannot resolve modules
  const RETRY_SCALES = [0.5, 0.35, 0.25]; // dot-style codes often decode once shrunk

  // Draw the image at `scale` onto a white-padded canvas. White padding gives
  // tightly cropped images the quiet zone jsQR needs, and keeps transparent
  // pixels from reading as black. SVGs without intrinsic size report 0x0.
  function render(img, scale) {
    const w = Math.max(1, Math.round((img.naturalWidth || 1024) * scale));
    const h = Math.max(1, Math.round((img.naturalHeight || 1024) * scale));
    const pad = Math.round(Math.max(w, h) * 0.1);
    decodeCanvas.width = w + pad * 2;
    decodeCanvas.height = h + pad * 2;
    decodeCtx.fillStyle = '#fff';
    decodeCtx.fillRect(0, 0, decodeCanvas.width, decodeCanvas.height);
    decodeCtx.drawImage(img, pad, pad, w, h);
    return decodeCtx.getImageData(0, 0, decodeCanvas.width, decodeCanvas.height);
  }

  // Lazily yields RGBA candidates from cheapest to most expensive, so easy
  // images stop at the first jsQR call.
  function* decodeCandidates(img) {
    const longest = Math.max(img.naturalWidth || 1024, img.naturalHeight || 1024);
    const base = Math.min(1, MAX_DECODE_DIM / longest);
    const full = render(img, base);
    yield full;

    for (const s of RETRY_SCALES) {
      if (longest * base * s < MIN_DECODE_DIM) break;
      yield render(img, base * s);
    }

    const { width, height } = full;
    for (const channel of DECODE_CHANNELS) {
      const stretched = stretchContrast(extractChannel(full.data, width, height, channel));
      if (stretched) yield grayscaleImageData(width, height, stretched);
    }

    const luma = extractChannel(full.data, width, height, DECODE_CHANNELS[0]);
    for (const radius of BLUR_RADII) {
      const blurred = stretchContrast(boxBlur(luma, width, height, radius));
      if (blurred) yield grayscaleImageData(width, height, blurred);
    }
  }

  function decodeImage(img) {
    let code = null;
    for (const candidate of decodeCandidates(img)) {
      code = jsQR(candidate.data, candidate.width, candidate.height);
      if (code && code.data) break;
    }

    if (code && code.data) {
      decodeOut.value = code.data;
      setDecodeMsg('');
    } else {
      decodeOut.value = '';
      setDecodeMsg('No QR code found in this image.');
    }
  }

  function handleFile(file) {
    if (!file || !file.type.startsWith('image/')) {
      setDecodeMsg('Please provide an image file.');
      return;
    }
    const url = URL.createObjectURL(file);
    decodeImg.onload = () => {
      decodePreview.hidden = false;
      decodeImage(decodeImg);
      URL.revokeObjectURL(url);
    };
    decodeImg.onerror = () => {
      setDecodeMsg('Could not load that image.');
      URL.revokeObjectURL(url);
    };
    decodeImg.src = url;
  }

  dropEl.addEventListener('click', () => fileEl.click());
  dropEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileEl.click(); }
  });
  fileEl.addEventListener('change', () => {
    if (fileEl.files && fileEl.files[0]) handleFile(fileEl.files[0]);
  });

  for (const evt of ['dragenter', 'dragover']) {
    dropEl.addEventListener(evt, (e) => { e.preventDefault(); dropEl.classList.add('qr-drop-active'); });
  }
  for (const evt of ['dragleave', 'drop']) {
    dropEl.addEventListener(evt, (e) => { e.preventDefault(); dropEl.classList.remove('qr-drop-active'); });
  }
  dropEl.addEventListener('drop', (e) => {
    const file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
    if (file) handleFile(file);
  });

  document.addEventListener('paste', (e) => {
    if (panelDecode.hidden) return;
    const items = e.clipboardData && e.clipboardData.items;
    if (!items) return;
    for (const item of items) {
      if (item.type && item.type.startsWith('image/')) {
        const file = item.getAsFile();
        if (file) { handleFile(file); break; }
      }
    }
  });

  decodeCopy.addEventListener('click', async () => {
    if (!decodeOut.value) return;
    await navigator.clipboard.writeText(decodeOut.value);
    const prev = decodeCopy.textContent;
    decodeCopy.textContent = 'Copied';
    setTimeout(() => { decodeCopy.textContent = prev; }, 1200);
  });
</script>
