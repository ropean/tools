---
import ToolLayout from '../layouts/ToolLayout.astro';
import { TOOLS } from '../data/tools.js';

const tool = TOOLS.find((t) => t.id === 'qr-generator');
---
<ToolLayout tool={tool}>
  <div class="qr">
    <div class="qr-tabs" role="tablist">
      <button type="button" class="qr-tab active" id="qr-tab-generate" role="tab" aria-selected="true">Generate</button>
      <button type="button" class="qr-tab" id="qr-tab-decode" role="tab" aria-selected="false">Decode</button>
    </div>

    <div class="qr-panel" id="qr-panel-generate">
      <div class="qr-field">
        <label class="qr-label" for="qr-text">Text or URL</label>
        <textarea class="field mono" id="qr-text" rows="4" spellcheck="false" placeholder="https://tools.ropean.org">https://tools.ropean.org</textarea>
      </div>

      <div class="qr-row">
        <div class="qr-field">
          <label class="qr-label" for="qr-ecl">Error correction</label>
          <select class="field" id="qr-ecl">
            <option value="L">L — 7%</option>
            <option value="M" selected>M — 15%</option>
            <option value="Q">Q — 25%</option>
            <option value="H">H — 30%</option>
          </select>
        </div>
        <div class="qr-field">
          <label class="qr-label" for="qr-size">Size (px)</label>
          <input class="field" type="number" id="qr-size" value="320" min="80" max="2000" step="8" />
        </div>
        <div class="qr-field">
          <label class="qr-label" for="qr-margin">Quiet zone</label>
          <input class="field" type="number" id="qr-margin" value="4" min="0" max="16" />
        </div>
      </div>

      <div class="qr-row">
        <div class="qr-field qr-color">
          <label class="qr-label" for="qr-dark">Foreground</label>
          <input type="color" id="qr-dark" value="#1c1c1c" />
        </div>
        <div class="qr-field qr-color">
          <label class="qr-label" for="qr-light">Background</label>
          <input type="color" id="qr-light" value="#ffffff" />
        </div>
      </div>

      <p class="qr-msg" id="qr-msg" hidden></p>

      <div class="qr-preview">
        <div class="qr-canvas-wrap">
          <canvas id="qr-canvas" width="320" height="320" aria-label="QR code preview"></canvas>
        </div>
        <div class="qr-actions">
          <button type="button" class="btn btn-primary" id="qr-png">Download PNG</button>
          <button type="button" class="btn" id="qr-svg">Download SVG</button>
        </div>
      </div>
    </div>

    <div class="qr-panel" id="qr-panel-decode" hidden>
      <div class="qr-field">
        <label class="qr-label" for="qr-drop">Source image</label>
        <div class="qr-drop" id="qr-drop" tabindex="0" role="button" aria-label="Upload, drag & drop, or paste an image to decode">
          <p class="qr-drop-text">Click to upload, drag &amp; drop an image, or paste (Ctrl/Cmd+V)</p>
          <input type="file" id="qr-file" accept="image/*" hidden />
        </div>
      </div>

      <div class="qr-decode-preview" id="qr-decode-preview" hidden>
        <img id="qr-decode-img" alt="Uploaded image" />
      </div>

      <p class="qr-msg" id="qr-decode-msg" hidden></p>

      <div class="qr-field">
        <label class="qr-label" for="qr-decode-out">Decoded text</label>
        <textarea class="field mono" id="qr-decode-out" rows="4" spellcheck="false" readonly placeholder="Decoded text will appear here"></textarea>
      </div>
      <div class="qr-actions">
        <button type="button" class="btn btn-copy" id="qr-decode-copy">Copy</button>
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .qr { display: flex; flex-direction: column; gap: 20px; }

  .qr-tabs { display: inline-flex; align-self: flex-start; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .qr-tab { background: transparent; border: none; padding: 7px 16px; font-size: 13px; color: var(--muted); cursor: pointer; }
  .qr-tab.active { background: var(--dark); color: var(--on-dark); }

  .qr-panel { display: flex; flex-direction: column; gap: 16px; }

  .qr-field { display: flex; flex-direction: column; gap: 6px; }
  .qr-label { font-size: 12px; color: var(--muted); }
  .qr-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .qr-row .qr-field { flex: 1 1 120px; }
  .qr-color input[type='color'] {
    width: 100%; height: 40px; padding: 4px;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--bg); cursor: pointer;
  }
  .qr-msg { margin: 0; font-size: 13px; color: var(--error); }

  .qr-preview { display: flex; flex-direction: column; gap: 16px; align-items: center; }
  .qr-canvas-wrap {
    width: 100%;
    max-width: 420px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--subtle-2);
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #qr-canvas { max-width: 100%; height: auto; image-rendering: pixelated; border-radius: 4px; }
  .qr-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }

  .qr-drop {
    display: flex; align-items: center; justify-content: center; text-align: center;
    min-height: 140px; padding: 24px;
    border: 1px dashed var(--border-strong); border-radius: var(--radius-lg);
    background: var(--subtle-2); cursor: pointer;
  }
  .qr-drop.qr-drop-active { border-color: var(--fg); background: var(--subtle); }
  .qr-drop-text { margin: 0; font-size: 13px; color: var(--muted); }

  .qr-decode-preview {
    display: flex; justify-content: center;
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    background: var(--subtle-2); padding: 16px;
  }
  .qr-decode-preview img { max-width: 100%; max-height: 320px; border-radius: 4px; }
</style>

<script>
  import qrcode from 'qrcode-generator';
  import jsQR from 'jsqr';

  const $ = (id) => document.getElementById(id);

  // ---- Tabs ----
  const tabGenerate = $('qr-tab-generate');
  const tabDecode = $('qr-tab-decode');
  const panelGenerate = $('qr-panel-generate');
  const panelDecode = $('qr-panel-decode');

  function showTab(which) {
    const generate = which === 'generate';
    panelGenerate.hidden = !generate;
    panelDecode.hidden = generate;
    tabGenerate.classList.toggle('active', generate);
    tabDecode.classList.toggle('active', !generate);
    tabGenerate.setAttribute('aria-selected', String(generate));
    tabDecode.setAttribute('aria-selected', String(!generate));
  }
  tabGenerate.addEventListener('click', () => showTab('generate'));
  tabDecode.addEventListener('click', () => showTab('decode'));

  // ---- Generate ----
  const textEl = $('qr-text');
  const eclEl = $('qr-ecl');
  const sizeEl = $('qr-size');
  const marginEl = $('qr-margin');
  const darkEl = $('qr-dark');
  const lightEl = $('qr-light');
  const canvas = $('qr-canvas');
  const ctx = canvas.getContext('2d');
  const msgEl = $('qr-msg');

  let model = null; // last successful QR model, for exports

  function setMsg(text) {
    if (!text) { msgEl.hidden = true; msgEl.textContent = ''; return; }
    msgEl.hidden = false;
    msgEl.textContent = text;
  }

  function build() {
    const text = textEl.value;
    if (!text) { model = null; ctx.clearRect(0, 0, canvas.width, canvas.height); setMsg(''); return; }
    try {
      const qr = qrcode(0, eclEl.value); // 0 = auto-pick smallest version
      qr.addData(text);
      qr.make();
      model = qr;
      setMsg('');
      draw();
    } catch (err) {
      model = null;
      setMsg('Cannot encode: ' + (err && err.message ? err.message : 'text too long for this level.'));
    }
  }

  function geometry() {
    const count = model.getModuleCount();
    const margin = Math.max(0, parseInt(marginEl.value, 10) || 0);
    const total = count + margin * 2;
    const target = Math.max(80, parseInt(sizeEl.value, 10) || 320);
    const scale = Math.max(1, Math.floor(target / total)); // integer px per module = crisp
    return { count, margin, total, scale, dim: scale * total };
  }

  function draw() {
    if (!model) return;
    const { count, margin, scale, dim } = geometry();
    canvas.width = dim;
    canvas.height = dim;
    ctx.fillStyle = lightEl.value;
    ctx.fillRect(0, 0, dim, dim);
    ctx.fillStyle = darkEl.value;
    for (let r = 0; r < count; r++) {
      for (let c = 0; c < count; c++) {
        if (model.isDark(r, c)) ctx.fillRect((c + margin) * scale, (r + margin) * scale, scale, scale);
      }
    }
  }

  function svgString() {
    const { count, margin, total } = geometry();
    let path = '';
    for (let r = 0; r < count; r++) {
      for (let c = 0; c < count; c++) {
        if (model.isDark(r, c)) path += 'M' + (c + margin) + ' ' + (r + margin) + 'h1v1h-1z';
      }
    }
    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${total} ${total}" shape-rendering="crispEdges">`
      + `<rect width="${total}" height="${total}" fill="${lightEl.value}"/>`
      + `<path d="${path}" fill="${darkEl.value}"/></svg>`;
  }

  function download(href, name) {
    const a = document.createElement('a');
    a.href = href;
    a.download = name;
    document.body.appendChild(a);
    a.click();
    a.remove();
  }

  $('qr-png').addEventListener('click', () => {
    if (!model) return;
    download(canvas.toDataURL('image/png'), 'qrcode.png');
  });
  $('qr-svg').addEventListener('click', () => {
    if (!model) return;
    const blob = new Blob([svgString()], { type: 'image/svg+xml' });
    const url = URL.createObjectURL(blob);
    download(url, 'qrcode.svg');
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });

  // Text/level changes rebuild the model (debounced); size/margin/color only redraw.
  let t;
  textEl.addEventListener('input', () => { clearTimeout(t); t = setTimeout(build, 150); });
  eclEl.addEventListener('change', build);
  for (const el of [sizeEl, marginEl, darkEl, lightEl]) {
    el.addEventListener('input', () => { if (model) draw(); });
  }

  build();

  // ---- Decode ----
  const dropEl = $('qr-drop');
  const fileEl = $('qr-file');
  const decodePreview = $('qr-decode-preview');
  const decodeImg = $('qr-decode-img');
  const decodeMsg = $('qr-decode-msg');
  const decodeOut = $('qr-decode-out');
  const decodeCopy = $('qr-decode-copy');
  const decodeCanvas = document.createElement('canvas');
  const decodeCtx = decodeCanvas.getContext('2d', { willReadFrequently: true });

  function setDecodeMsg(text) {
    if (!text) { decodeMsg.hidden = true; decodeMsg.textContent = ''; return; }
    decodeMsg.hidden = false;
    decodeMsg.textContent = text;
  }

  function decodeImage(img) {
    decodeCanvas.width = img.naturalWidth;
    decodeCanvas.height = img.naturalHeight;
    decodeCtx.drawImage(img, 0, 0);
    const imageData = decodeCtx.getImageData(0, 0, decodeCanvas.width, decodeCanvas.height);
    const code = jsQR(imageData.data, imageData.width, imageData.height);
    if (code && code.data) {
      decodeOut.value = code.data;
      setDecodeMsg('');
    } else {
      decodeOut.value = '';
      setDecodeMsg('No QR code found in this image.');
    }
  }

  function handleFile(file) {
    if (!file || !file.type.startsWith('image/')) {
      setDecodeMsg('Please provide an image file.');
      return;
    }
    const url = URL.createObjectURL(file);
    decodeImg.onload = () => {
      decodePreview.hidden = false;
      decodeImage(decodeImg);
      URL.revokeObjectURL(url);
    };
    decodeImg.onerror = () => {
      setDecodeMsg('Could not load that image.');
      URL.revokeObjectURL(url);
    };
    decodeImg.src = url;
  }

  dropEl.addEventListener('click', () => fileEl.click());
  dropEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileEl.click(); }
  });
  fileEl.addEventListener('change', () => {
    if (fileEl.files && fileEl.files[0]) handleFile(fileEl.files[0]);
  });

  for (const evt of ['dragenter', 'dragover']) {
    dropEl.addEventListener(evt, (e) => { e.preventDefault(); dropEl.classList.add('qr-drop-active'); });
  }
  for (const evt of ['dragleave', 'drop']) {
    dropEl.addEventListener(evt, (e) => { e.preventDefault(); dropEl.classList.remove('qr-drop-active'); });
  }
  dropEl.addEventListener('drop', (e) => {
    const file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
    if (file) handleFile(file);
  });

  document.addEventListener('paste', (e) => {
    if (panelDecode.hidden) return;
    const items = e.clipboardData && e.clipboardData.items;
    if (!items) return;
    for (const item of items) {
      if (item.type && item.type.startsWith('image/')) {
        const file = item.getAsFile();
        if (file) { handleFile(file); break; }
      }
    }
  });

  decodeCopy.addEventListener('click', async () => {
    if (!decodeOut.value) return;
    await navigator.clipboard.writeText(decodeOut.value);
    const prev = decodeCopy.textContent;
    decodeCopy.textContent = 'Copied';
    setTimeout(() => { decodeCopy.textContent = prev; }, 1200);
  });
</script>
